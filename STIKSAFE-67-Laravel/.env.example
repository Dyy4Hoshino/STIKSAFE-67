APP_NAME=STIKSAFE-67
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stiksafe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Scan Engine: http mengarah ke ML Service lokal (port 8001)
ML_SCAN_DRIVER=http
ML_SERVICE_URL=http://127.0.0.1:8001
# ML shared secret. Set a unique secret on deployment; do not reuse this example value.
ML_SERVICE_TOKEN=
ML_SERVICE_TIMEOUT=120

STIKSAFE_FILE_RETENTION_DAYS=7
STIKSAFE_SCAN_MAX_DURATION_MIN=15

VITE_APP_NAME="${APP_NAME}"
